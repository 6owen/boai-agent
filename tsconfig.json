{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "./apps/electron/src/renderer/*"
      ],
      "@shared/*": [
        "./packages/shared/src/*"
      ],
      "@boai/ui": [
        "./packages/ui/src/index.ts"
      ],
      "@boai/ui/*": [
        "./packages/ui/src/components/*",
        "./packages/ui/src/*"
      ],
      "@boai/tokens": [
        "./packages/tokens/src/index.ts"
      ],
      "@boai/tokens/*": [
        "./packages/tokens/src/*",
        "./packages/tokens/dist/*"
      ],
      "@boai/shared": [
        "./packages/shared/src/domain/index.ts"
      ],
      "@boai/shared/*": [
        "./packages/shared/src/*"
      ],
      "@boai/runtime": [
        "./packages/runtime/src/index.ts"
      ],
      "@boai/runtime/*": [
        "./packages/runtime/src/*"
      ],
      "@boai/transport": [
        "./packages/transport/src/index.ts"
      ],
      "@boai/transport/*": [
        "./packages/transport/src/*"
      ],
      "@boai/runtime-plugin-sdk": [
        "./packages/runtime-plugin-sdk/src/runtime-api.ts"
      ],
      "@boai/runtime-plugin-sdk/manifest": [
        "./packages/runtime-plugin-sdk/src/manifest.ts"
      ],
      "@boai/runtime-plugins/pi": [
        "./packages/runtime-plugins/src/pi.ts"
      ],
      "@boai/runtime-plugins/opencode": [
        "./packages/runtime-plugins/src/opencode.ts"
      ],
      "@boai/runtime-plugins/acp": [
        "./packages/runtime-plugins/src/acp.ts"
      ]
    }
  },
  "include": [
    "apps/*/src",
    "packages/*/src",
    "tests",
    "scripts/workspace-packages.d.mts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "apps/design-docs/vite.config.ts"
  ]
}
