{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "./src/renderer/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ],
      "@boai/ui": [
        "./packages/ui/src/index.ts"
      ],
      "@boai/ui/*": [
        "./packages/ui/src/components/*",
        "./packages/ui/src/*"
      ],
      "@boai/tokens": [
        "./packages/tokens/src/index.ts"
      ],
      "@boai/tokens/*": [
        "./packages/tokens/src/*",
        "./packages/tokens/dist/*"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "packages/tokens/src",
    "packages/ui/src",
    "apps/design-docs/src",
    "apps/design-docs/vite.config.ts"
  ]
}
