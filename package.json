{
  "name": "boai-agent",
  "version": "0.2.2",
  "private": true,
  "description": "Local-first digital teammates powered by Mastra",
  "type": "module",
  "main": "dist/main/main.cjs",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:electron": "pnpm build && pnpm test:bddgen && playwright test",
    "start": "electron .",
    "package": "pnpm build && electron-builder --dir",
    "dist:mac": "pnpm build && electron-builder --mac dmg",
    "lint:ui": "eslint src/renderer",
    "test:bddgen": "bddgen",
    "test:electron:list": "pnpm test:bddgen && playwright test --list",
    "test:electron:report": "playwright show-report",
    "eval:collaboration": "node scripts/evaluate-collaboration.mjs",
    "eval:score": "node scripts/score-collaboration.mjs",
    "eval:dataset": "node scripts/score-collaboration.mjs --list"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.0",
    "@ai-sdk/anthropic": "2.0.105",
    "@base-ui/react": "1.8.0",
    "@libsql/client": "0.18.0",
    "@lobehub/icons-static-svg": "1.95.1",
    "@mastra/core": "1.71.0",
    "@mastra/libsql": "1.23.3",
    "@mastra/memory": "1.32.1",
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "croner": "9.1.0",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "react": "19.3.0",
    "react-day-picker": "10.0.1",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.14.1",
    "recharts": "3.8.0",
    "remark-gfm": "4.0.1",
    "smol-toml": "1.9.0",
    "yaml": "2.9.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "build": {
    "appId": "com.boai.agent",
    "productName": "BoAI Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@libsql/**/*",
      "node_modules/libsql/**/*",
      "node_modules/@mastra/**/*",
      "node_modules/@parcel/watcher/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/eslint-parser": "7.29.9",
    "@babel/plugin-syntax-typescript": "7.29.7",
    "@egoist/tailwindcss-icons": "1.9.2",
    "@iconify-json/carbon": "1.2.28",
    "@iconify-json/solar": "1.2.13",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "39.2.7",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "playwright-bdd": "9.2.1",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
