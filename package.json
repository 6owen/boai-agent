{
  "name": "boai-agent",
  "version": "0.2.2",
  "private": true,
  "description": "Local-first digital teammates powered by Mastra",
  "type": "module",
  "main": "dist/main/main.cjs",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "lint:typography": "node scripts/check-typography.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:collaboration": "node scripts/test-group-collaboration.mjs",
    "test:electron": "pnpm build && pnpm test:bddgen && playwright test",
    "start": "electron .",
    "package": "pnpm build && electron-builder --dir",
    "dist:mac": "pnpm build && electron-builder --mac dmg",
    "lint:ui": "eslint src/renderer",
    "test:bddgen": "bddgen",
    "test:electron:list": "pnpm test:bddgen && playwright test --list",
    "test:electron:report": "playwright show-report",
    "eval:collaboration": "node scripts/evaluate-collaboration.mjs",
    "eval:score": "node scripts/score-collaboration.mjs",
    "eval:dataset": "node scripts/score-collaboration.mjs --list",
    "eval:experiment": "node scripts/evaluation-experiment.mjs",
    "dev:repair": "node scripts/iterate-agent.mjs",
    "eval:build": "node scripts/evaluation-experiment.mjs build",
    "eval:hillclimb": "node scripts/evaluation-experiment.mjs hillclimb",
    "cli": "node dist/cli/index.mjs",
    "test:ui": "pnpm build && node scripts/ui-regression.mjs check",
    "test:ui:candidate": "pnpm build && node scripts/ui-regression.mjs candidate",
    "test:ui:accept": "node scripts/ui-regression.mjs accept",
    "dev:task": "node scripts/dev-task.mjs",
    "design:prepare": "node scripts/design.mjs prepare",
    "design:serve": "node scripts/design.mjs serve",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.0",
    "@ai-sdk/anthropic": "2.0.105",
    "@babel/parser": "7.29.9",
    "@base-ui/react": "1.8.0",
    "@extend-ai/react-docx": "0.9.2",
    "@extend-ai/react-pptx": "0.2.1",
    "@extend-ai/react-xlsx": "0.16.5",
    "@iconify-json/lucide": "1.2.130",
    "@iconify/utils": "3.1.7",
    "@larksuite/channel": "0.7.1",
    "@larksuite/vercel-chat-adapter": "0.3.0",
    "@libsql/client": "0.18.0",
    "@lobehub/icons-static-svg": "1.95.1",
    "@mastra/core": "1.71.0",
    "@mastra/libsql": "1.23.3",
    "@mastra/memory": "1.32.1",
    "@mastra/observability": "1.18.1",
    "@mastra/telegram": "0.2.2",
    "@mathjax/src": "4.1.3",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@napi-rs/canvas": "1.0.10",
    "@pierre/diffs": "1.0.10",
    "@shadcn/react": "0.3.1",
    "@tanstack/react-virtual": "3.14.13",
    "@tiptap/core": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "beautiful-mermaid": "1.1.3",
    "chat": "4.41.1",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "croner": "9.1.0",
    "date-fns": "4.4.0",
    "dingtalk-stream": "2.1.5",
    "embla-carousel-react": "8.6.0",
    "fflate": "0.8.3",
    "iconoir-react": "7.12.1",
    "input-otp": "1.5.0",
    "jszip": "3.10.1",
    "motion": "13.5.0",
    "pdfjs-dist": "6.3.289",
    "pptxgenjs": "4.0.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-day-picker": "10.0.1",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.14.1",
    "recharts": "3.8.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "shiki": "4.4.3",
    "smol-toml": "1.9.0",
    "sonner": "2.0.8",
    "unified": "11.0.5",
    "ws": "8.21.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "2.9.1",
    "yauzl": "3.4.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "build": {
    "appId": "com.boai.agent",
    "buildVersion": "0.2.3",
    "productName": "BoAI Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@libsql/**/*",
      "node_modules/libsql/**/*",
      "node_modules/@mastra/**/*",
      "node_modules/@parcel/watcher/**/*",
      "dist/native/**/*",
      "dist/main/app-icons/**/*",
      "dist/runtime/plugins/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/app-icons/default.icns",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "protocols": [
      {
        "name": "BOAI model connection import",
        "schemes": [
          "boai"
        ],
        "role": "Editor"
      }
    ]
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/eslint-parser": "7.29.9",
    "@babel/plugin-syntax-typescript": "7.29.7",
    "@egoist/tailwindcss-icons": "1.9.2",
    "@iconify-json/carbon": "1.2.28",
    "@iconify-json/solar": "1.2.13",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "39.2.7",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "jsdom": "26.1.0",
    "playwright-bdd": "9.2.1",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "bin": {
    "boai": "dist/cli/index.mjs"
  }
}
