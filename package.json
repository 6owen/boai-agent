{
  "name": "boai-agent",
  "version": "0.2.2",
  "private": true,
  "description": "Local-first digital teammates powered by Mastra",
  "type": "module",
  "main": "dist/main/main.cjs",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:electron": "playwright test",
    "start": "electron .",
    "package": "pnpm build && electron-builder --dir",
    "dist:mac": "pnpm build && electron-builder --mac dmg"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.0",
    "@ai-sdk/anthropic": "2.0.105",
    "@libsql/client": "0.18.0",
    "@mastra/core": "1.71.0",
    "@mastra/libsql": "1.23.3",
    "@mastra/memory": "1.32.1",
    "croner": "9.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "build": {
    "appId": "com.boai.agent",
    "productName": "BoAI Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@libsql/**/*",
      "node_modules/libsql/**/*",
      "node_modules/@mastra/**/*",
      "node_modules/@parcel/watcher/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false
  },
  "devDependencies": {
    "@egoist/tailwindcss-icons": "1.9.2",
    "@iconify-json/carbon": "1.2.28",
    "@iconify-json/solar": "1.2.13",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "39.2.7",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
