{
  "mcpServers": {
    "Context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {
        "DEFAULT_MINIMUM_TOKENS": "[REDACTED:env-or-header]"
      }
    },
    "Fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ]
    },
    "Playwright MCP": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "computer-use": {
      "command": "/Applications/Alma.app/Contents/MacOS/Alma",
      "args": [
        "/Applications/Alma.app/Contents/Resources/cli/alma-computer-use-mcp.mjs"
      ],
      "env": {
        "ELECTRON_RUN_AS_NODE": "[REDACTED:env-or-header]"
      }
    }
  }
}
