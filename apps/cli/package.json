{
  "name": "@boai/cli",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "description": "BOAI command-line application entry",
  "scripts": {
    "dev": "node ../../scripts/dev-cli.mjs",
    "dev:client": "node ../../scripts/dev-cli.mjs --client-only",
    "build": "node ../../scripts/build.mjs --app cli",
    "build:client": "node ../../scripts/build.mjs --app cli-client",
    "start": "pnpm --dir ../.. cli"
  },
  "dependencies": {
    "@boai/shared": "workspace:*",
    "@boai/transport": "workspace:*"
  }
}
