diff --git a/dist/private/utils/runAfterTransition.js b/dist/private/utils/runAfterTransition.js
--- a/dist/private/utils/runAfterTransition.js
+++ b/dist/private/utils/runAfterTransition.js
@@ -35,9 +35,9 @@
         // The transitioncancel event must be registered on the element itself, rather than as a global
         // event. This enables us to handle when the node is deleted from the document while it is transitioning.
         // In that case, the cancel event would have nowhere to bubble to so we need to handle it directly.
-        eventTarget.addEventListener('transitioncancel', $aa33e9569e5401d5$var$onTransitionEnd, {
-            once: true
-        });
+        // Keep listening for every property, including after a child's bubbling cancellation.
+        // onTransitionEnd removes this listener when the element's property set is empty.
+        eventTarget.addEventListener('transitioncancel', $aa33e9569e5401d5$var$onTransitionEnd);
     }
     transitions.add(e.propertyName);
 }
